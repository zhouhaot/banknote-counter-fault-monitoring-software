<Window x:Class="MoneyCounter.Desktop.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:MoneyCounter.Desktop.ViewModels"
 Title="{Binding Title}" Width="1150" Height="800" MinWidth="1000" MinHeight="680" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="OperationsWindow">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Latest}" Margin="0,8" AutomationProperties.AutomationId="LatestStatus"/><TextBlock Text="时间统一使用北京时间（UTC+8）。状态由业务记录提供，不代表设备实时连接状态。" Foreground="#555555"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="OperationsFeedback"/>
  <TabControl IsEnabled="{Binding IsReady}">
   <TabItem Header="状态记录" AutomationProperties.AutomationId="StatusTab">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,16,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="上一页" Command="{Binding PreviousStatusCommand}"/><TextBlock Text="{Binding StatusPageInfo}" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextStatusCommand}"/></StackPanel>
      <DataGrid ItemsSource="{Binding Statuses}" AutomationProperties.AutomationId="StatusHistory"><DataGrid.Columns>
       <DataGridTextColumn Header="记录时间" Binding="{Binding Time}" Width="160"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="65"/><DataGridTextColumn Header="累计读数" Binding="{Binding Count}" Width="100"/><DataGridTextColumn Header="增量" Binding="{Binding Increment}" Width="90"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="85"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="160"/>
      </DataGrid.Columns></DataGrid>
     </DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="新增人工状态记录" FontSize="18" Margin="4,0,0,12"/>
      <Label Content="记录时间 *" Target="{Binding ElementName=RecordedTime}"/><TextBox x:Name="RecordedTime" Text="{Binding RecordedAt,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecordedAt"/>
      <Label Content="运行状态 *" Target="{Binding ElementName=StateChoice}"/><ComboBox x:Name="StateChoice" ItemsSource="{x:Static vm:OperationsViewModel.States}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding SelectedState}" AutomationProperties.AutomationId="DeviceState"/>
      <Label Content="累计点钞读数 *" Target="{Binding ElementName=CountInput}"/><TextBox x:Name="CountInput" Text="{Binding CumulativeCount,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CumulativeCount"/>
      <Label Content="备注" Target="{Binding ElementName=StatusNotes}"/><TextBox x:Name="StatusNotes" Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" MaxLength="2000" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusNotes"/>
      <Button Content="保存状态记录" Command="{Binding SaveStatusCommand}" AutomationProperties.AutomationId="SaveStatus"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="异常管理" AutomationProperties.AutomationId="AnomalyTab">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,16,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="上一页" Command="{Binding PreviousAnomalyCommand}"/><TextBlock Text="{Binding AnomalyPageInfo}" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextAnomalyCommand}"/></StackPanel>
      <DataGrid ItemsSource="{Binding Anomalies}" SelectedItem="{Binding SelectedAnomaly}" AutomationProperties.AutomationId="AnomalyHistory"><DataGrid.Columns>
       <DataGridTextColumn Header="发现时间" Binding="{Binding Time}" Width="160"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="70"/><DataGridTextColumn Header="异常现象" Binding="{Binding Description}" Width="170"/><DataGridTextColumn Header="处理说明" Binding="{Binding Handling}" Width="170"/><DataGridTextColumn Header="关闭时间" Binding="{Binding Closed}" Width="160"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="90"/>
      </DataGrid.Columns></DataGrid>
     </DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="登记异常" FontSize="18" Margin="4,0,0,8"/>
      <Label Content="发现时间 *" Target="{Binding ElementName=DiscoveredTime}"/><TextBox x:Name="DiscoveredTime" Text="{Binding DiscoveredAt,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DiscoveredAt"/>
      <Label Content="异常现象 *" Target="{Binding ElementName=AnomalyDescription}"/><TextBox x:Name="AnomalyDescription" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000" AutomationProperties.AutomationId="AnomalyDescription"/>
      <Button Content="登记异常" Command="{Binding SaveAnomalyCommand}" AutomationProperties.AutomationId="SaveAnomaly"/>
      <Separator Margin="0,16"/><TextBlock Text="关闭选中的异常" FontSize="18" Margin="4,0,0,8"/>
      <Label Content="关闭时间 *" Target="{Binding ElementName=ClosedTime}"/><TextBox x:Name="ClosedTime" Text="{Binding ClosedAt,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ClosedAt"/>
      <Label Content="处理说明 *" Target="{Binding ElementName=HandlingInput}"/><TextBox x:Name="HandlingInput" Text="{Binding HandlingNotes,UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000" AutomationProperties.AutomationId="HandlingNotes"/>
      <Button Content="关闭异常" Command="{Binding CloseAnomalyCommand}" AutomationProperties.AutomationId="CloseAnomaly"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
