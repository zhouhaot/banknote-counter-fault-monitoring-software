<Window x:Class="MoneyCounter.Desktop.AnalyticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="统计分析" Width="1180" Height="780" MinWidth="850" MinHeight="580" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="AnalyticsWindow">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="设备寿命与故障趋势" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="历史记录统计；利用率不代表剩余寿命预测。日期均按北京时间计算。" TextWrapping="Wrap" Margin="4,10"/>
   <WrapPanel IsEnabled="{Binding IsReady}">
    <Label Content="统计日期"/><DatePicker SelectedDate="{Binding AsOf}" Width="145" AutomationProperties.Name="统计日期"/>
    <Label Content="型号"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Label" Width="220" AutomationProperties.Name="统计型号"/>
    <Label Content="完整资产编号"/><TextBox Text="{Binding AssetCode,UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.AutomationId="AnalyticsAsset"/>
    <ComboBox ItemsSource="{Binding States}" SelectedValue="{Binding SelectedState}" SelectedValuePath="Code" DisplayMemberPath="Label" Width="135" AutomationProperties.Name="最新状态"/><CheckBox Content="包含模拟数据" IsChecked="{Binding IncludeSimulated}" VerticalAlignment="Center" Margin="8" AutomationProperties.AutomationId="AnalyticsIncludeSimulation"/>
   </WrapPanel>
   <WrapPanel IsEnabled="{Binding IsReady}"><Label Content="趋势起日"/><DatePicker SelectedDate="{Binding TrendFrom}" Width="145" AutomationProperties.Name="趋势起日"/><Label Content="趋势止日"/><DatePicker SelectedDate="{Binding TrendTo}" Width="145" AutomationProperties.Name="趋势止日"/><ComboBox ItemsSource="{Binding FaultTypes}" SelectedValue="{Binding SelectedFaultType}" SelectedValuePath="Code" DisplayMemberPath="Label" Width="160" AutomationProperties.Name="故障类型"/><ComboBox ItemsSource="{Binding Severities}" SelectedValue="{Binding SelectedSeverity}" SelectedValuePath="Code" DisplayMemberPath="Label" Width="160" AutomationProperties.Name="严重程度"/><Button Content="查询统计" Click="RefreshClick" AutomationProperties.AutomationId="RefreshAnalytics"/></WrapPanel>
   <TextBlock Text="{Binding DashboardText}" TextWrapping="Wrap" Margin="4,12" AutomationProperties.AutomationId="AnalyticsDashboard"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><Button Content="取消查询" Click="CancelClick" IsEnabled="{Binding IsBusy}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="4,8" AutomationProperties.AutomationId="AnalyticsFeedback"/></StackPanel>
  <TabControl>
   <TabItem Header="寿命利用率"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsReady}"><Button Content="上一页" Click="PreviousClick"/><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="8"/><Button Content="下一页" Click="NextClick"/></StackPanel>
    <DataGrid ItemsSource="{Binding LifeRows}" AutomationProperties.AutomationId="AnalyticsLifeGrid"><DataGrid.Columns>
     <DataGridTextColumn Header="资产编号" Binding="{Binding Row.AssetCode}" Width="155"/><DataGridTextColumn Header="型号" Binding="{Binding Row.ModelName}" Width="140"/><DataGridTextColumn Header="最新读数" Binding="{Binding Count}" Width="120"/><DataGridTextColumn Header="额定寿命" Binding="{Binding Rated}" Width="120"/><DataGridTextColumn Header="利用率" Binding="{Binding Utilization}" Width="110"/><DataGridTextColumn Header="设备年龄" Binding="{Binding Age}" Width="110"/><DataGridTextColumn Header="记录状态" Binding="{Binding Status}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="故障趋势" AutomationProperties.AutomationId="AnalyticsTrendTab"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding TrendSummary}" TextWrapping="Wrap" Margin="8" AutomationProperties.AutomationId="AnalyticsTrendSummary"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Trend}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock><Run Text="{Binding Month}"/><Run Text="："/><Run Text="{Binding Count}"/><Run Text=" 条"/></TextBlock><Border Height="20" Width="{Binding BarWidth}" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" HorizontalAlignment="Left" Margin="0,4"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <DataGrid Grid.Column="1" ItemsSource="{Binding Trend}" AutomationProperties.AutomationId="AnalyticsTrendGrid"><DataGrid.Columns><DataGridTextColumn Header="月份" Binding="{Binding Month}" Width="*"/><DataGridTextColumn Header="故障登记数" Binding="{Binding Count}" Width="*"/></DataGrid.Columns></DataGrid>
    </Grid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
