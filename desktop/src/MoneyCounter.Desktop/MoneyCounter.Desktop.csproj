    <ProjectReference Include="..\MoneyCounter.Core\MoneyCounter.Core.csproj" />
    <ProjectReference Include="..\MoneyCounter.Infrastructure\MoneyCounter.Infrastructure.csproj" />
  </ItemGroup>
</Project>
