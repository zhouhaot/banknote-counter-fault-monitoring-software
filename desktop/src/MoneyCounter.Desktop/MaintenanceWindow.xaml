<Window x:Class="MoneyCounter.Desktop.MaintenanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="1240" Height="850" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="MaintenanceWindow">
 <DockPanel Margin="16">
  <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="24" Margin="0,0,0,10"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Feedback}" TextWrapping="Wrap" Margin="0,10" AutomationProperties.AutomationId="MaintenanceFeedback"/>
  <TabControl IsEnabled="{Binding IsReady}">
   <TabItem Header="故障列表与登记" AutomationProperties.AutomationId="FaultListTab">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid ItemsSource="{Binding Faults}" SelectedItem="{Binding SelectedFault}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" AutomationProperties.AutomationId="FaultGrid">
      <DataGrid.Columns><DataGridTextColumn Header="故障编号" Binding="{Binding Number}" Width="150"/><DataGridTextColumn Header="登记时间（北京时间）" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="类型" Binding="{Binding Type}"/><DataGridTextColumn Header="严重程度" Binding="{Binding Severity}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source}"/></DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><Button Content="打开详情" Click="OpenFault_Click" AutomationProperties.AutomationId="OpenFault"/><Button Content="刷新" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshFaults"/><Button Content="上一页" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextPageCommand}"/></StackPanel>
     <GroupBox Grid.Row="2" Header="{Binding CreationSource}"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="登记时间（北京时间）"/><TextBlock Grid.Column="1" Text="故障描述"/><TextBlock Grid.Column="2" Text="类型"/><TextBlock Grid.Column="3" Text="严重程度"/>
      <TextBox Grid.Row="1" Text="{Binding RegisteredAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FaultRegisteredAt" ToolTip="yyyy-MM-dd HH:mm:ss"/>
      <TextBox Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FaultDescription"/>
      <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Types}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding FaultType}" AutomationProperties.AutomationId="FaultType"/>
      <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Severities}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Severity}" AutomationProperties.AutomationId="FaultSeverity"/>
      <TextBlock Grid.Row="2" Text="yyyy-MM-dd HH:mm:ss" FontSize="11"/>
      <Button Grid.Row="3" Grid.Column="3" Content="登记故障" Command="{Binding CreateFaultCommand}" AutomationProperties.AutomationId="CreateFault"/>
     </Grid></GroupBox>
    </Grid>
   </TabItem>
   <TabItem x:Name="DetailTab" Header="故障详情与维修" AutomationProperties.AutomationId="FaultDetailTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
     <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,6,0,12" AutomationProperties.AutomationId="FaultDetailText"/>
     <Button Content="耗材领用与流水（独立保存）" Click="Inventory_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="FaultInventory"/>
     <StackPanel Orientation="Horizontal"><TextBlock Text="处理 / 关闭时间（北京时间）" VerticalAlignment="Center"/><TextBox Width="180" Text="{Binding ActionAt, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="FaultActionAt"/><Button Content="开始处理" Command="{Binding StartFaultCommand}" IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="StartFault"/></StackPanel>
     <DataGrid Height="210" ItemsSource="{Binding Repairs}" SelectedItem="{Binding SelectedRepair}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" AutomationProperties.AutomationId="RepairGrid"><DataGrid.Columns><DataGridTextColumn Header="维修时间（北京时间）" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="维修措施" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="维修结果" Binding="{Binding Result}" Width="*"/><DataGridTextColumn Header="维修人" Binding="{Binding Technician}" Width="100"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid>
     <StackPanel Orientation="Horizontal"><Button Content="维修上一页" Command="{Binding PreviousRepairPageCommand}"/><TextBlock Text="{Binding RepairPageInfo}" VerticalAlignment="Center"/><Button Content="维修下一页" Command="{Binding NextRepairPageCommand}"/><Button Content="编辑所选维修" Command="{Binding EditRepairCommand}" IsEnabled="{Binding CanMaintain}" AutomationProperties.AutomationId="EditRepair"/><Button Content="删除所选维修" Command="{Binding DeleteRepairCommand}" IsEnabled="{Binding CanMaintain}" AutomationProperties.AutomationId="DeleteRepair"/></StackPanel>
     <GroupBox Header="维修录入（故障关闭后只读）" IsEnabled="{Binding CanMaintain}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="维修时间（北京时间）"/><TextBlock Grid.Column="1" Text="维修措施"/><TextBlock Grid.Column="2" Text="维修结果"/>
      <TextBox Grid.Row="1" Text="{Binding RepairedAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepairAt"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RepairAction, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepairAction"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding RepairResult, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepairResult"/>
      <TextBlock Grid.Row="2" Text="维修人"/><TextBlock Grid.Row="2" Grid.Column="1" Text="备注"/>
      <TextBox Grid.Row="3" Text="{Binding Technician, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepairTechnician"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RepairNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepairNotes"/><StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal"><Button Content="保存维修" Command="{Binding SaveRepairCommand}" AutomationProperties.AutomationId="SaveRepair"/><Button Content="重置 / 新增" Command="{Binding NewRepairCommand}" AutomationProperties.AutomationId="NewRepair"/></StackPanel>
     </Grid></GroupBox>
     <GroupBox Header="关闭故障" IsEnabled="{Binding CanMaintain}"><StackPanel Margin="8"><TextBlock Text="关闭时间（北京时间 yyyy-MM-dd HH:mm:ss）"/><TextBox Text="{Binding ActionAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FaultClosedAt"/><TextBlock Text="最终处理结论"/><TextBox Text="{Binding FinalResult, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="55" TextWrapping="Wrap" AutomationProperties.AutomationId="FaultFinalResult"/><Button Content="关闭故障" Command="{Binding CloseFaultCommand}" HorizontalAlignment="Right" AutomationProperties.AutomationId="CloseFault"/></StackPanel></GroupBox>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
