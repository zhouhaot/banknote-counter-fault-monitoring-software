<Window x:Class="MoneyCounter.Desktop.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:MoneyCounter.Desktop.ViewModels"
 Title="CSV 数据导入" Width="1100" Height="780" MinWidth="900" MinHeight="620" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="ImportWindow">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="CSV 数据导入" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="支持型号、设备和状态三种固定模板。UTF-8 CSV，上限 5 MiB / 10000 行；整批校验，整批保存。" TextWrapping="Wrap" Margin="4,10"/>
   <StackPanel IsEnabled="{Binding IsReady}">
    <StackPanel Orientation="Horizontal"><Label Content="导入类型"/><ComboBox Width="150" ItemsSource="{x:Static vm:ImportViewModel.Kinds}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding Kind}" AutomationProperties.Name="导入类型" AutomationProperties.AutomationId="ImportKind"/><Button Content="保存模板" Click="TemplateClick"/></StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="选择 CSV 文件" Click="ChooseClick" AutomationProperties.AutomationId="ChooseCsv"/><TextBox Text="{Binding FilePath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CSV 文件绝对路径" AutomationProperties.AutomationId="CsvPath"/></DockPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal"><Button Content="预览与校验" Click="PreviewClick" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="PreviewCsv"/><Button Content="确认导入整批" Click="CommitClick" IsEnabled="{Binding CanCommit}" AutomationProperties.AutomationId="CommitCsv"/><Button Content="取消当前操作" Click="CancelClick" IsEnabled="{Binding IsBusy}" AutomationProperties.AutomationId="CancelCsv"/><Button Content="导出错误清单" Click="ErrorsClick" IsEnabled="{Binding IsReady}"/></StackPanel>
   <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="4,8" AutomationProperties.AutomationId="CsvPreviewSummary"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Feedback}" Margin="4,10" TextWrapping="Wrap" AutomationProperties.AutomationId="ImportFeedback"/>
  <TabControl>
   <TabItem Header="逐行错误"><DataGrid ItemsSource="{Binding Errors}" AutomationProperties.AutomationId="CsvErrors"><DataGrid.Columns><DataGridTextColumn Header="逻辑行" Binding="{Binding Row}" Width="80"/><DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="170"/><DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="170"/><DataGridTextColumn Header="错误说明" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="已提交批次" AutomationProperties.AutomationId="ImportHistoryTab"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" IsEnabled="{Binding IsReady}"><Button Content="上一页" Click="PreviousClick"/><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/><Button Content="下一页" Click="NextClick"/><Button Content="刷新" Click="RefreshClick"/></StackPanel><DataGrid ItemsSource="{Binding History}" AutomationProperties.AutomationId="ImportHistory"><DataGrid.Columns><DataGridTextColumn Header="批次" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="记录数" Binding="{Binding RowCount}" Width="90"/><DataGridTextColumn Header="提交时间（UTC）" Binding="{Binding ImportedAtUtc}" Width="220"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
