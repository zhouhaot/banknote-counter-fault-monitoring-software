<Window x:Class="MoneyCounter.Desktop.InventoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:MoneyCounter.Desktop.ViewModels"
 Title="耗材库存" Width="1200" Height="820" MinWidth="1000" MinHeight="680" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="InventoryWindow">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="耗材与库存流水" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding ContextText}" Margin="0,8" TextWrapping="Wrap"/><Button Content="刷新库存与流水" Click="Refresh_Click" HorizontalAlignment="Left" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="RefreshInventory"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Feedback}" TextWrapping="Wrap" Margin="4,10" AutomationProperties.AutomationId="InventoryFeedback"/>
  <Grid IsEnabled="{Binding IsReady}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <TabControl Margin="0,0,12,0">
    <TabItem Header="耗材目录" AutomationProperties.AutomationId="ConsumablesTab"><DockPanel Margin="8">
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="220" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索耗材名称" AutomationProperties.AutomationId="ConsumableSearch"/><Button Content="搜索" Command="{Binding SearchCatalogCommand}" AutomationProperties.AutomationId="SearchConsumables"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="上一页" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextCommand}"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="新增耗材" Command="{Binding NewConsumableCommand}" AutomationProperties.AutomationId="NewConsumable"/><Button Content="编辑选中耗材" Command="{Binding EditConsumableCommand}" AutomationProperties.AutomationId="EditConsumable"/><Button Content="停用选中耗材" Command="{Binding DeactivateCommand}" AutomationProperties.AutomationId="DeactivateConsumable"/></StackPanel></StackPanel>
     <DataGrid ItemsSource="{Binding Consumables}" SelectedItem="{Binding SelectedConsumable}" SelectionMode="Single" AutomationProperties.AutomationId="ConsumableGrid"><DataGrid.Columns><DataGridTextColumn Header="耗材名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65"/><DataGridTextColumn Header="当前库存" Binding="{Binding CurrentStock,StringFormat=F2}" Width="110"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="60"/><DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="130"/></DataGrid.Columns></DataGrid>
    </DockPanel></TabItem>
    <TabItem Header="库存流水（只读）" AutomationProperties.AutomationId="InventoryLedgerTab"><DockPanel Margin="8">
     <TextBlock DockPanel.Dock="Top" Text="历史流水不可修改或删除。选中记录后填写右侧时间和原因进行冲正。" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="上一页" Command="{Binding PreviousMovementCommand}"/><TextBlock Text="{Binding MovementPageInfo}" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextMovementCommand}"/></StackPanel><Button Content="冲正选中流水" Command="{Binding ReverseMovementCommand}" AutomationProperties.AutomationId="ReverseMovement"/></StackPanel>
     <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}" SelectionMode="Single" AutomationProperties.AutomationId="InventoryLedger"><DataGrid.Columns><DataGridTextColumn Header="编号" Binding="{Binding Record.Id}" Width="60"/><DataGridTextColumn Header="北京时间" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="耗材" Binding="{Binding Name}" Width="110"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="85"/><DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="110"/><DataGridTextColumn Header="故障编号" Binding="{Binding Fault}" Width="80"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="150"/><DataGridTextColumn Header="冲正状态" Binding="{Binding Reversal}" Width="100"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80"/></DataGrid.Columns></DataGrid>
    </DockPanel></TabItem>
   </TabControl>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Expander Header="耗材资料：新增 / 编辑" IsExpanded="True"><StackPanel>
     <Label Content="耗材名称 *" Target="{Binding ElementName=NameInput}"/><TextBox x:Name="NameInput" Text="{Binding ConsumableName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.AutomationId="ConsumableName"/>
     <Label Content="单位 *" Target="{Binding ElementName=UnitInput}"/><TextBox x:Name="UnitInput" Text="{Binding Unit,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.AutomationId="ConsumableUnit"/>
     <Label Content="备注" Target="{Binding ElementName=NotesInput}"/><TextBox x:Name="NotesInput" Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AutomationProperties.AutomationId="ConsumableNotes"/>
     <Button Content="保存耗材资料" Command="{Binding SaveConsumableCommand}" AutomationProperties.AutomationId="SaveConsumable"/>
    </StackPanel></Expander>
    <Separator Margin="0,12"/><TextBlock Text="登记库存流水" FontSize="18"/>
    <TextBlock Text="{Binding SelectedConsumable.Name,StringFormat=当前耗材：{0},TargetNullValue=请先在左侧耗材目录选择耗材}" Margin="4,8" TextWrapping="Wrap" AutomationProperties.AutomationId="MovementConsumable"/>
    <Label Content="操作类型 *" Target="{Binding ElementName=TypeChoice}"/><ComboBox x:Name="TypeChoice" ItemsSource="{x:Static vm:InventoryViewModel.Types}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding MovementType}" AutomationProperties.AutomationId="MovementType"/>
    <Label Content="数量 *（最多两位小数）" Target="{Binding ElementName=QuantityInput}"/><TextBox x:Name="QuantityInput" Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MovementQuantity"/>
    <Label Content="北京时间 *（yyyy-MM-dd HH:mm:ss）" Target="{Binding ElementName=TimeInput}"/><TextBox x:Name="TimeInput" Text="{Binding OccurredAt,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MovementTime"/>
    <Label Content="原因 *（冲正也使用此处时间和原因）" Target="{Binding ElementName=ReasonInput}"/><TextBox x:Name="ReasonInput" Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" MaxLength="2000" AutomationProperties.AutomationId="MovementReason"/>
    <Label Content="查找关联设备（领用必选）" Target="{Binding ElementName=DeviceSearchInput}"/><TextBox x:Name="DeviceSearchInput" Text="{Binding DeviceSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="InventoryDeviceSearch"/><Button Content="查找设备" Command="{Binding FindDevicesCommand}" AutomationProperties.AutomationId="FindInventoryDevices"/>
    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="AssetCode" AutomationProperties.Name="关联设备" AutomationProperties.AutomationId="InventoryDevice"/>
    <Button Content="加载此设备故障" Command="{Binding LoadFaultsCommand}" AutomationProperties.AutomationId="LoadInventoryFaults"/><ComboBox ItemsSource="{Binding Faults}" SelectedItem="{Binding SelectedFault}" DisplayMemberPath="FaultNo" AutomationProperties.Name="关联故障（可选）" AutomationProperties.AutomationId="InventoryFault"/>
    <Button Content="清除设备和故障关联" Command="{Binding ClearAssociationCommand}" AutomationProperties.AutomationId="ClearInventoryAssociation"/>
    <Button Content="保存库存流水" Command="{Binding PostMovementCommand}" AutomationProperties.AutomationId="PostMovement"/>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
