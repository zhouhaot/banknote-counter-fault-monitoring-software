<Window x:Class="MoneyCounter.Desktop.BackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="备份与恢复" Width="1040" Height="650" MinWidth="800" MinHeight="500" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="BackupWindow">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="本地备份与恢复" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="备份为 SQLite 一致快照，包含数据库校验清单。恢复前会验证哈希、完整性、外键和应用支持的结构版本。" TextWrapping="Wrap" Margin="4,12"/><TextBlock Text="恢复失败时会自动回退到恢复前数据库；完成前不要关闭窗口或断开存储设备。" TextWrapping="Wrap" Margin="4"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="创建备份" Click="CreateClick" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="CreateBackup"/><Button Content="恢复选中备份" Click="RestoreClick" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="RestoreBackup"/><Button Content="刷新列表" Click="RefreshClick" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="RefreshBackups"/><Button Content="取消当前操作" Click="CancelClick" IsEnabled="{Binding IsBusy}" AutomationProperties.AutomationId="CancelBackup"/></StackPanel><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="4,12" AutomationProperties.AutomationId="BackupFeedback"/></StackPanel>
  <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="BackupGrid"><DataGrid.Columns><DataGridTextColumn Header="创建时间（UTC）" Binding="{Binding CreatedAtUtc}" Width="220"/><DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="大小（字节）" Binding="{Binding ByteCount}" Width="140"/><DataGridTextColumn Header="结构版本" Binding="{Binding SchemaVersion}" Width="100"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="260"/></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
