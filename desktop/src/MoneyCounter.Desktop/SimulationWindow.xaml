<Window x:Class="MoneyCounter.Desktop.SimulationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="演示数据管理" Width="1000" Height="680" MinWidth="850" MinHeight="560" FontSize="14" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="SimulationWindow">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="演示数据 · 独立模拟集" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="生成型号、设备、状态、异常、故障维修和耗材流水，所有记录均标记为模拟数据。" TextWrapping="Wrap" Margin="4,12"/><TextBlock Text="演示不代表真实点钞机连接、实时采集或自动故障诊断。相同种子不能重复创建；清除后可重新生成。" TextWrapping="Wrap" Margin="4"/>
   <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsReady}"><Label Content="整数种子"/><TextBox Width="220" Text="{Binding Seed,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模拟种子" AutomationProperties.AutomationId="SimulationSeed"/><Button Content="创建模拟集" Click="CreateClick" AutomationProperties.AutomationId="CreateSimulation"/><Button Content="刷新列表" Click="RefreshClick" AutomationProperties.AutomationId="RefreshSimulation"/></StackPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="清除选中模拟集" Click="ResetClick" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="ResetSimulation"/><Button Content="取消当前操作" Click="CancelClick" IsEnabled="{Binding IsBusy}" AutomationProperties.AutomationId="CancelSimulation"/></StackPanel><TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Margin="4,12" AutomationProperties.AutomationId="SimulationFeedback"/></StackPanel>
  <DataGrid ItemsSource="{Binding Datasets}" SelectedItem="{Binding SelectedDataset}" SelectionMode="Single" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="SimulationGrid"><DataGrid.Columns><DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="模拟集名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="种子" Binding="{Binding Seed}" Width="160"/><DataGridTextColumn Header="创建时间（UTC）" Binding="{Binding CreatedAtUtc}" Width="220"/><DataGridTextColumn Header="生成器" Binding="{Binding GeneratorVersion}" Width="110"/></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
